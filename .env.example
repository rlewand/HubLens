# Database
DATABASE_URL="postgresql://hublens:hublens@localhost:5432/hublens?schema=hublens"

# Autodesk Platform Services (APS) OAuth — optional for local dev
APS_CLIENT_ID=""
APS_CLIENT_SECRET=""
APS_CALLBACK_URL="http://localhost:3000/api/auth/callback"

# Optional: fetch live Docs folders/files/versions via Data Management API (test script / /api/docs-metrics)
# Requires APS app provisioned on the target BIM 360 / ACC account with data:read scope.
# APS_ENRICH_DOCS_METRICS=true
# APS_DOCS_METRICS_MAX_PROJECTS=5
# APS_DOCS_METRICS_PROJECT_IDS=820af33b-9af2-4778-8d34-2c08774c6ccf
# APS_INCLUDE_ALL_VERSIONS=false

# Full Docs inventory scan during ingest (folders, files, versions, formats → database)
# APS_SCAN_DOCS_INVENTORY=true
# APS_DOCS_SCAN_MAX_PROJECTS=0
# APS_DOCS_SCAN_MAX_ITEMS_PER_PROJECT=10000
# APS_DOCS_SCAN_PROJECT_IDS=project-uuid-1,project-uuid-2

# Session encryption (generate: openssl rand -base64 32)
SESSION_SECRET="change-me-to-a-random-32-byte-secret"

# Local development: bypass APS login with a mock consultant user
AUTH_MOCK=true

# Max CSV upload size in MB (ACC exports can be large)
MAX_UPLOAD_SIZE_MB=2048
